{
  "openapi": "3.1.0",
  "info": {"title": "planted", "version": "1"},
  "paths": {
    "/v1/things": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Thing"}
              }
            }
          }
        }
      },
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/ThingIn"}
            }
          }
        },
        "responses": {"201": {"description": "created"}}
      }
    }
  },
  "components": {
    "schemas": {
      "Thing": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "size": {"type": "string", "enum": ["small", "large"]}
        }
      },
      "ThingIn": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string"},
          "size": {"type": "string", "enum": ["small", "large"]}
        }
      }
    }
  }
}
