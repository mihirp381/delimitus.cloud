{
  "name": "ssc-console",
  "private": true,
  "version": "0.0.1",
  "description": "SSC admin console (SSC-057).",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "gen:api": "openapi-typescript ../docs/api/openapi.json -o src/api/schema.d.ts",
    "gen:tokens": "SSC_WRITE_TOKENS=1 vitest run test/tokens.test.ts",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "1.170.38",
    "openapi-fetch": "0.17.0",
    "openapi-react-query": "0.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tanstack/router-plugin": "1.168.40",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
