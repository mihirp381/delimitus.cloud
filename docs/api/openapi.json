        "type": "object"
      },
      "PrincipalKind": {
        "enum": [
          "user",
          "workload",
          "operator"
        ],
        "title": "PrincipalKind",
        "type": "string"
      },
      "Problem": {
        "additionalProperties": false,
        "description": "The wire shape of every refusal (RFC 9457). Rendered by exactly one function.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "detail": {
            "description": "Fixed, human-readable explanation. Never carries evidence.",
            "title": "Detail",
            "type": "string"
          },
          "instance": {
            "description": "The request path.",
            "title": "Instance",
            "type": "string"
          },
          "request_id": {
            "description": "Quote this to support. Evidence is logged under it.",
            "title": "Request Id",
            "type": "string"
          },
          "status": {
            "maximum": 599,
            "minimum": 400,
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "description": "Fixed, human-readable summary of the code.",
            "title": "Title",
            "type": "string"
          },
          "type": {
            "description": "A URL naming the error code.",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "request_id"
        ],
        "title": "Problem",
        "type": "object"
      },
      "Whoami": {
        "additionalProperties": false,
        "properties": {
          "client_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
