              "$ref": "#/components/schemas/EnvironmentOut"
            },
            "title": "Environments",
            "type": "array"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "owner_user_id": {
            "title": "Owner User Id",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "disabled",
              "quarantined"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug",
          "owner_user_id",
          "status",
          "created_at",
          "environments"
        ],
        "title": "AppOut",
        "type": "object"
      },
      "AppSummary": {
        "additionalProperties": false,
