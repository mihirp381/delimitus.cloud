          "org_id": {
            "title": "Org Id",
            "type": "string"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          }
        },
        "required": [
          "org_id",
          "subject",
          "kind",
          "credential_id",
          "is_agent",
          "client_id"
        ],
        "title": "Whoami",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "One API for the command line, the GitHub Action, the console and the agent interface.\n\n* Every refusal is an RFC 9457 problem (`application/problem+json`) with a `code` from the error\n  catalogue and a `request_id`. The text is fixed; evidence stays in our logs under that id.\n* Every `POST` requires an `Idempotency-Key` header. A retry with the same key and body returns\n  the first answer with `Idempotency-Replayed: true`.\n* Edits to sharing rules require `If-Match` with the `ETag` from the last read.\n* A deployment is a long-running operation: `202` with a `Location` to poll.\n* Requests are rate-limited per credential; `429` carries `Retry-After`.\n",
    "title": "Small Software Cloud API",
    "version": "1"
  },
  "openapi": "3.1.0",
