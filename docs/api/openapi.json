            "title": "Slug",
            "type": "string"
          }
        },
        "required": [
          "slug"
        ],
        "title": "AppCreate",
        "type": "object"
      },
      "AppList": {
        "additionalProperties": false,
        "properties": {
          "apps": {
            "items": {
              "$ref": "#/components/schemas/AppSummary"
            },
            "title": "Apps",
            "type": "array"
          }
        },
        "required": [
          "apps"
        ],
        "title": "AppList",
        "type": "object"
      },
      "AppOut": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
