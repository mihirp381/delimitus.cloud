{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SscListUnderThePrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<bucket>",
      "Condition": {
        "StringLike": {
          "s3:prefix": "<prefix>*"
        }
      }
    },
    {
      "Sid": "SscReadUnderThePrefix",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::<bucket>/<prefix>*"
    }
  ]
}
